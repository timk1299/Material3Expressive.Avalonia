<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="https://github.com/timk1299/material3-expressive-avalonia"
             x:Class="Material3Expressive.Avalonia.Demo.Views.PickersPage">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Material3Expressive.Avalonia.Demo/Views/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel Margin="24,0,24,24" Spacing="16">
      <m3:Card Classes="Outlined">
        <StackPanel Spacing="16">
          <TextBlock Classes="TitleMediumEmphasized" Text="Date and time fields" />
          <TextBlock Classes="BodyMedium OnSurfaceVariant" TextWrapping="Wrap"
                     Text="Type a date or time, or use the button: dates open the docked calendar, times open the time picker dialog." />
          <StackPanel Orientation="Horizontal" Spacing="24">
            <m3:DateField Name="BirthdayField" Width="260" Label="Date of birth" VerticalAlignment="Top" />
            <m3:DateField Classes="Outlined" Width="260" Label="Check-in" VerticalAlignment="Top" />
            <m3:TimeField Name="AlarmField" Width="220" Label="Alarm" VerticalAlignment="Top" />
            <m3:TimeField Classes="Outlined" Width="220" Label="Meeting" VerticalAlignment="Top" />
          </StackPanel>
        </StackPanel>
      </m3:Card>

      <m3:Card Classes="Outlined">
        <StackPanel Spacing="16">
          <TextBlock Classes="TitleMediumEmphasized" Text="Modal pickers" />
          <WrapPanel>
            <Button Name="PickDate" Classes="Tonal" Margin="0,0,8,8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource IconCalendar}" />
                <TextBlock Text="Date picker" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="PickRange" Classes="Tonal" Margin="0,0,8,8" Content="Date range picker" />
            <Button Name="PickDateInput" Classes="Outlined" Margin="0,0,8,8" Content="Date input" />
            <Button Name="PickWeekday" Classes="Outlined" Margin="0,0,8,8" Content="Weekdays in the next 3 months" />
            <Button Name="PickTime" Classes="Tonal" Margin="0,0,8,8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource IconSchedule}" />
                <TextBlock Text="Time picker" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="PickTime24" Classes="Outlined" Margin="0,0,8,8" Content="24-hour time picker" />
            <Button Name="PickTimeLandscape" Classes="Outlined" Margin="0,0,8,8" Content="Landscape time picker" />
            <Button Name="PickTimeInput" Classes="Outlined" Margin="0,0,8,8" Content="Time input" />
          </WrapPanel>
          <TextBlock Name="PickerResult" Classes="BodyMedium OnSurfaceVariant" Text="Results appear here." />
        </StackPanel>
      </m3:Card>

      <Grid ColumnDefinitions="Auto,16,Auto,16,*">
        <m3:Card Classes="Filled" Padding="0" CornerRadius="{DynamicResource M3ShapeExtraLarge}" Background="{DynamicResource M3SurfaceContainerHighBrush}">
          <m3:DatePickerPanel Name="InlineDate" ShowModeToggle="True" />
        </m3:Card>
        <m3:Card Grid.Column="2" Classes="Filled" Padding="0,0,0,8" CornerRadius="{DynamicResource M3ShapeExtraLarge}" VerticalAlignment="Top" Background="{DynamicResource M3SurfaceContainerHighBrush}">
          <m3:TimePickerPanel Name="InlineTime" />
        </m3:Card>
        <StackPanel Grid.Column="4" Spacing="8">
          <TextBlock Classes="TitleMediumEmphasized" Text="Inline panels" />
          <TextBlock Classes="BodyMedium OnSurfaceVariant" TextWrapping="Wrap"
                     Text="DatePickerPanel, TimePickerPanel and CalendarView can also be placed anywhere in a layout and bound to your view model." />
          <TextBlock Name="InlineResult" Classes="BodyLarge" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
