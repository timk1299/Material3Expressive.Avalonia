<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Material3Expressive.Avalonia.Controls">

  <!--
    Material 3 Expressive progress indicators.
      (default) linear: 4dp, active = primary, track = secondary container, 4dp gap, stop dot at the end
      Classes="Wavy"     : the active indicator is a moving wave (10dp tall)
      Classes="Thick"    : 8dp stroke
      Classes="Circular" : 40dp circular indicator (48dp when Wavy)
    Determinate progress changes are smoothed with a spring.
  -->
  <ControlTheme x:Key="{x:Type ProgressBar}" TargetType="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource M3PrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource M3SecondaryContainerBrush}" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate TargetType="ProgressBar">
        <Panel>
          <Border Name="PART_Indicator" IsVisible="False" />
          <controls:LinearProgressPresenter Name="PART_Presenter"
                                            Percentage="{TemplateBinding Percentage}"
                                            IsIndeterminate="{TemplateBinding IsIndeterminate}"
                                            ActiveBrush="{TemplateBinding Foreground}"
                                            TrackBrush="{TemplateBinding Background}" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:horizontal">
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="Height" Value="4" />
    </Style>
    <Style Selector="^:horizontal.Wavy">
      <Setter Property="Height" Value="10" />
      <Style Selector="^ /template/ controls|LinearProgressPresenter#PART_Presenter">
        <Setter Property="IsWavy" Value="True" />
      </Style>
    </Style>
    <Style Selector="^:horizontal.Thick">
      <Setter Property="Height" Value="8" />
      <Style Selector="^ /template/ controls|LinearProgressPresenter#PART_Presenter">
        <Setter Property="Thickness" Value="8" />
      </Style>
    </Style>
    <Style Selector="^:horizontal.Thick.Wavy">
      <Setter Property="Height" Value="14" />
    </Style>

    <!-- Vertical bars use a flat template -->
    <Style Selector="^:vertical">
  <Setter Property="Template">
      <ControlTemplate TargetType="ProgressBar">
        <Border Name="ProgressBarRoot"
                Background="{TemplateBinding Background}"
                ClipToBounds="True"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Panel>
            <Panel Name="DeterminateRoot" Opacity="1">
              <Border Name="PART_Indicator"
                      Margin="{TemplateBinding Padding}"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="{TemplateBinding CornerRadius}" />
            </Panel>
            <Panel Name="IndeterminateRoot" Opacity="0">
              <Border Name="IndeterminateProgressBarIndicator"
                      Margin="{TemplateBinding Padding}"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="{TemplateBinding CornerRadius}" />
              <Border Name="IndeterminateProgressBarIndicator2"
                      Margin="{TemplateBinding Padding}"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="{TemplateBinding CornerRadius}" />
            </Panel>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
    </Style>
    <Style Selector="^:vertical">
      <Setter Property="MinHeight" Value="120" />
      <Setter Property="Width" Value="4" />
      <Style Selector="^ /template/ Border#PART_Indicator">
        <Setter Property="VerticalAlignment" Value="Bottom" />
      </Style>
      <Style Selector="^ /template/ Border#IndeterminateProgressBarIndicator">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Height" Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerWidth}" />
      </Style>
      <Style Selector="^ /template/ Border#IndeterminateProgressBarIndicator2">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Height" Value="{Binding $parent[ProgressBar].TemplateSettings.Container2Width}" />
      </Style>
    </Style>

    <Style Selector="^:indeterminate">
      <Style Selector="^ /template/ Panel#DeterminateRoot">
        <Setter Property="Opacity" Value="0" />
      </Style>
      <Style Selector="^ /template/ Panel#IndeterminateRoot">
        <Setter Property="Opacity" Value="1" />
      </Style>
    </Style>

    <Style Selector="^:vertical:indeterminate /template/ Border#IndeterminateProgressBarIndicator">
      <Style.Animations>
        <Animation IterationCount="Infinite" Duration="0:0:2">
          <KeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:0">
            <Setter Property="TranslateTransform.Y" Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerAnimationStartPosition}" />
          </KeyFrame>
          <KeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:1.5">
            <Setter Property="TranslateTransform.Y" Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerAnimationEndPosition}" />
          </KeyFrame>
          <KeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:2">
            <Setter Property="TranslateTransform.Y" Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerAnimationEndPosition}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="^:vertical:indeterminate /template/ Border#IndeterminateProgressBarIndicator2">
      <Style.Animations>
        <Animation IterationCount="Infinite" Duration="0:0:2">
          <KeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:0">
            <Setter Property="TranslateTransform.Y" Value="{Binding $parent[ProgressBar].TemplateSettings.Container2AnimationStartPosition}" />
          </KeyFrame>
          <KeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:0.75">
            <Setter Property="TranslateTransform.Y" Value="{Binding $parent[ProgressBar].TemplateSettings.Container2AnimationStartPosition}" />
          </KeyFrame>
          <KeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:2">
            <Setter Property="TranslateTransform.Y" Value="{Binding $parent[ProgressBar].TemplateSettings.Container2AnimationEndPosition}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>


    <!-- ================= Circular ================= -->
    <Style Selector="^.Circular">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ProgressBar">
          <Panel>
            <Border Name="PART_Indicator" IsVisible="False" />
            <controls:CircularProgressPresenter Name="PART_Presenter"
                                                Percentage="{TemplateBinding Percentage}"
                                                IsIndeterminate="{TemplateBinding IsIndeterminate}"
                                                ActiveBrush="{TemplateBinding Foreground}"
                                                TrackBrush="{TemplateBinding Background}" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="^.Circular.Wavy">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="48" />
      <Style Selector="^ /template/ controls|CircularProgressPresenter#PART_Presenter">
        <Setter Property="IsWavy" Value="True" />
      </Style>
    </Style>
    <Style Selector="^.Circular.Thick /template/ controls|CircularProgressPresenter#PART_Presenter">
      <Setter Property="Thickness" Value="8" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource M3DisabledContentBrush}" />
      <Setter Property="Background" Value="{DynamicResource M3DisabledContainerBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
