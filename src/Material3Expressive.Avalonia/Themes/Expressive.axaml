<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Material3Expressive.Avalonia.Controls"
                    xmlns:conv="using:Material3Expressive.Avalonia.Converters"
                    xmlns:motion="using:Material3Expressive.Avalonia.Motion">

  <!-- ================= Loading indicator ================= -->
  <!-- (default) uncontained: primary · Classes="Contained": on-primary-container on primary-container -->
  <ControlTheme x:Key="{x:Type controls:LoadingIndicator}" TargetType="controls:LoadingIndicator">
    <Setter Property="Foreground" Value="{DynamicResource M3PrimaryBrush}" />
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Style Selector="^.Contained">
      <Setter Property="Background" Value="{DynamicResource M3PrimaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource M3OnPrimaryContainerBrush}" />
    </Style>
  </ControlTheme>

  <!-- ================= FAB menu ================= -->
  <ControlTheme x:Key="M3FabMenuToggle" TargetType="ToggleButton" BasedOn="{StaticResource M3ToggleButton}">
    <Setter Property="Background" Value="{DynamicResource M3PrimaryContainerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource M3OnPrimaryContainerBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="56" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Width" Duration="{motion:SpringDuration FastSpatial}" Easing="{motion:Spring FastSpatial}" />
        <DoubleTransition Property="Height" Duration="{motion:SpringDuration FastSpatial}" Easing="{motion:Spring FastSpatial}" />
      </Transitions>
    </Setter>
    <Style Selector="^ /template/ Border#PART_Container">
      <Setter Property="BoxShadow" Value="{DynamicResource M3Elevation3}" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Container">
      <Setter Property="BoxShadow" Value="{DynamicResource M3Elevation4}" />
    </Style>
    <Style Selector="^ /template/ controls|Ripple#PART_Ripple">
      <Setter Property="IsCentered" Value="True" />
    </Style>
    <Style Selector="^:pressed, ^:pressing">
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="^:checked, ^:checked:pressed, ^:checked:pressing">
      <Setter Property="Background" Value="{DynamicResource M3PrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource M3OnPrimaryBrush}" />
      <Setter Property="CornerRadius" Value="28" />
    </Style>
  </ControlTheme>

  <!--
    FAB menu. Classes: (default) primary · Secondary · Tertiary; closed FAB size: (default) 56 · Medium · Large.
    <m3:FabMenu Icon="{…}"><m3:FabMenuItem Icon="{…}" Content="Reply" /></m3:FabMenu>
  -->
  <ControlTheme x:Key="{x:Type controls:FabMenu}" TargetType="controls:FabMenu">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Spacing="4" HorizontalAlignment="Right" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="8" HorizontalAlignment="Right">
          <ItemsPresenter Name="PART_ItemsPresenter"
                          HorizontalAlignment="Right"
                          ItemsPanel="{TemplateBinding ItemsPanel}" />
          <ToggleButton Name="PART_ToggleButton"
                        Theme="{StaticResource M3FabMenuToggle}"
                        HorizontalAlignment="Right"
                        IsChecked="{TemplateBinding IsOpen, Mode=TwoWay}">
            <Panel>
              <ContentPresenter Name="PART_Icon" Content="{TemplateBinding Icon}" RenderTransform="rotate(0deg)">
                <ContentPresenter.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity" Duration="{motion:SpringDuration FastEffects}" Easing="{motion:Spring FastEffects}" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="{motion:SpringDuration FastSpatial}" Easing="{motion:Spring FastSpatial}" />
                  </Transitions>
                </ContentPresenter.Transitions>
              </ContentPresenter>
              <Panel Name="PART_CloseIcon" Opacity="0" RenderTransform="rotate(-90deg)">
                <Panel.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity" Duration="{motion:SpringDuration FastEffects}" Easing="{motion:Spring FastEffects}" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="{motion:SpringDuration FastSpatial}" Easing="{motion:Spring FastSpatial}" />
                  </Transitions>
                </Panel.Transitions>
                <ContentPresenter Content="{TemplateBinding CloseIcon}" />
                <PathIcon Width="20"
                          Height="20"
                          Data="{StaticResource M3CloseGeometry}"
                          IsVisible="{TemplateBinding CloseIcon, Converter={x:Static ObjectConverters.IsNull}}" />
              </Panel>
            </Panel>
          </ToggleButton>
        </StackPanel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:open">
      <Style Selector="^ /template/ ContentPresenter#PART_Icon">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="RenderTransform" Value="rotate(90deg)" />
      </Style>
      <Style Selector="^ /template/ Panel#PART_CloseIcon">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="RenderTransform" Value="rotate(0deg)" />
      </Style>
    </Style>
    <Style Selector="^.Medium:not(:open) /template/ ToggleButton#PART_ToggleButton">
      <Setter Property="Width" Value="80" />
      <Setter Property="Height" Value="80" />
      <Setter Property="CornerRadius" Value="20" />
    </Style>
    <Style Selector="^.Large:not(:open) /template/ ToggleButton#PART_ToggleButton">
      <Setter Property="Width" Value="96" />
      <Setter Property="Height" Value="96" />
      <Setter Property="CornerRadius" Value="28" />
    </Style>
    <Style Selector="^.Secondary /template/ ToggleButton#PART_ToggleButton">
      <Setter Property="Background" Value="{DynamicResource M3SecondaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource M3OnSecondaryContainerBrush}" />
    </Style>
    <Style Selector="^.Secondary:open /template/ ToggleButton#PART_ToggleButton">
      <Setter Property="Background" Value="{DynamicResource M3SecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource M3OnSecondaryBrush}" />
    </Style>
    <Style Selector="^.Tertiary /template/ ToggleButton#PART_ToggleButton">
      <Setter Property="Background" Value="{DynamicResource M3TertiaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource M3OnTertiaryContainerBrush}" />
    </Style>
    <Style Selector="^.Tertiary:open /template/ ToggleButton#PART_ToggleButton">
      <Setter Property="Background" Value="{DynamicResource M3TertiaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource M3OnTertiaryBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:FabMenuItem}" TargetType="controls:FabMenuItem" BasedOn="{StaticResource M3Button}">
    <Setter Property="Background" Value="{DynamicResource M3PrimaryContainerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource M3OnPrimaryContainerBrush}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Height" Value="56" />
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Padding" Value="24,0" />
    <Setter Property="CornerRadius" Value="28" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LetterSpacing" Value="0.15" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_FocusRing"
                  Margin="-5"
                  BorderThickness="3"
                  BorderBrush="{DynamicResource M3SecondaryBrush}"
                  CornerRadius="33"
                  IsHitTestVisible="False"
                  IsVisible="False" />
          <Border Name="PART_Container"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BoxShadow="{DynamicResource M3Elevation3}" />
          <Border Name="PART_StateLayer"
                  Background="{TemplateBinding Foreground}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Opacity="0"
                  IsHitTestVisible="False">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
              </Transitions>
            </Border.Transitions>
          </Border>
          <controls:Ripple Name="PART_Ripple" Brush="{TemplateBinding Foreground}" CornerRadius="{TemplateBinding CornerRadius}" />
          <StackPanel Margin="{TemplateBinding Padding}" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ContentPresenter Name="PART_IconPresenter" VerticalAlignment="Center" Content="{TemplateBinding Icon}" />
            <ContentPresenter Name="PART_ContentPresenter"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              RecognizesAccessKey="True" />
          </StackPanel>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ ContentPresenter#PART_IconPresenter:empty">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:pressed, ^:pressing">
      <Setter Property="CornerRadius" Value="28" />
    </Style>
  </ControlTheme>

  <!-- ================= Toolbars ================= -->
  <!--
    Floating toolbar: (default) standard · Classes="Vibrant"; Orientation="Vertical"; optional FloatingActionButton.
    Docked toolbar: full width, actions spread evenly; Classes="Vibrant".
  -->
  <ControlTheme x:Key="{x:Type controls:FloatingToolbar}" TargetType="controls:FloatingToolbar">
    <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="16" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="4" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="{TemplateBinding Orientation}" Spacing="8">
          <Border Name="PART_Container"
                  Background="{TemplateBinding Background}"
                  CornerRadius="32"
                  Height="64"
                  Padding="{TemplateBinding Padding}"
                  BoxShadow="{DynamicResource M3Elevation3}">
            <ItemsPresenter Name="PART_ItemsPresenter"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            ItemsPanel="{TemplateBinding ItemsPanel}" />
          </Border>
          <ContentPresenter Name="PART_Fab"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Content="{TemplateBinding FloatingActionButton}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ ContentPresenter#PART_Fab:empty">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:vertical">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Padding" Value="0,8" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Vertical" Spacing="4" />
        </ItemsPanelTemplate>
      </Setter>
      <Style Selector="^ /template/ Border#PART_Container">
        <Setter Property="Height" Value="NaN" />
        <Setter Property="Width" Value="64" />
      </Style>
    </Style>
    <Style Selector="^.Vibrant">
      <Setter Property="Background" Value="{DynamicResource M3PrimaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource M3OnPrimaryContainerBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:DockedToolbar}" TargetType="controls:DockedToolbar">
    <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
    <Setter Property="Height" Value="64" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <controls:SpaceEvenlyPanel MinSpacing="4" MaxSpacing="32" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ItemsPresenter Name="PART_ItemsPresenter" VerticalAlignment="Center" ItemsPanel="{TemplateBinding ItemsPanel}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.Vibrant">
      <Setter Property="Background" Value="{DynamicResource M3PrimaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource M3OnPrimaryContainerBrush}" />
    </Style>
  </ControlTheme>

  <!-- ================= Navigation rail ================= -->
  <!-- Rail destination: collapsed = icon in a 56x32 indicator with the label below;
       :expanded = a 56dp tall pill with the label next to the icon. -->
  <ControlTheme x:Key="M3RailItem" TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="0.5" />
    <Setter Property="Padding" Value="0,6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="{TemplateBinding Background}">
          <Grid Name="PART_Root"
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="Center"
                RowDefinitions="Auto,Auto"
                ColumnDefinitions="Auto,*">
            <Border Name="PART_Indicator"
                    Width="56"
                    Height="32"
                    CornerRadius="16"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource M3SecondaryContainerBrush}"
                    Opacity="0"
                    RenderTransform="scaleX(0.4)">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="{motion:SpringDuration FastEffects}" Easing="{motion:Spring FastEffects}" />
                  <TransformOperationsTransition Property="RenderTransform" Duration="{motion:SpringDuration FastSpatial}" Easing="{motion:Spring FastSpatial}" />
                </Transitions>
              </Border.Transitions>
            </Border>
            <Border Name="PART_StateLayer"
                    Width="56"
                    Height="32"
                    CornerRadius="16"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource M3OnSecondaryContainerBrush}"
                    Opacity="0"
                    IsHitTestVisible="False" />
            <controls:Ripple Name="PART_Ripple"
                             Width="56"
                             Height="32"
                             CornerRadius="16"
                             HorizontalAlignment="Center"
                             Brush="{DynamicResource M3OnSecondaryContainerBrush}" />
            <ContentPresenter Name="PART_IconPresenter"
                              Height="32"
                              HorizontalAlignment="Center"
                              VerticalContentAlignment="Center"
                              Content="{TemplateBinding Icon}"
                              ContentTemplate="{TemplateBinding IconTemplate}" />
            <ContentPresenter Name="PART_ContentPresenter"
                              Grid.Row="1"
                              Grid.ColumnSpan="2"
                              Margin="0,4,0,0"
                              HorizontalAlignment="Center"
                              Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              RecognizesAccessKey="True" />
          </Grid>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter:empty">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="{DynamicResource M3StateHoverOpacity}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="{DynamicResource M3StateFocusOpacity}" />
    </Style>
    <Style Selector="^:selected">
      <Style Selector="^ /template/ Border#PART_Indicator">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="RenderTransform" Value="scaleX(1)" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_IconPresenter">
        <Setter Property="Foreground" Value="{DynamicResource M3OnSecondaryContainerBrush}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource M3SecondaryBrush}" />
      </Style>
    </Style>

    <!-- Expanded: horizontal item -->
    <Style Selector="^:expanded">
      <Setter Property="Padding" Value="12,2" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="LetterSpacing" Value="0.1" />
      <Style Selector="^ /template/ Grid#PART_Root">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
      </Style>
      <Style Selector="^ /template/ Border#PART_Indicator, ^ /template/ Border#PART_StateLayer">
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="Width" Value="NaN" />
        <Setter Property="Height" Value="56" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
      </Style>
      <Style Selector="^ /template/ controls|Ripple#PART_Ripple">
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="Width" Value="NaN" />
        <Setter Property="Height" Value="56" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
      </Style>
      <Style Selector="^ /template/ Border#PART_Indicator">
        <Setter Property="RenderTransform" Value="scaleX(0.6)" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_IconPresenter">
        <Setter Property="Height" Value="56" />
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Grid.Row" Value="0" />
        <Setter Property="Grid.Column" Value="1" />
        <Setter Property="Grid.ColumnSpan" Value="1" />
        <Setter Property="Margin" Value="8,0,16,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </Style>
    <Style Selector="^:expanded:selected /template/ Border#PART_Indicator">
      <Setter Property="RenderTransform" Value="scaleX(1)" />
    </Style>
    <Style Selector="^:disabled /template/ Grid#PART_Root">
      <Setter Property="Opacity" Value="{DynamicResource M3DisabledContentOpacity}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:NavigationRail}" TargetType="controls:NavigationRail">
    <Setter Property="Background" Value="{DynamicResource M3SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
    <Setter Property="TabStripPlacement" Value="Left" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource M3RailItem}" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Vertical" Spacing="4" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <Border Name="PART_Rail"
                  DockPanel.Dock="Left"
                  Width="{TemplateBinding RailWidth}"
                  Background="{TemplateBinding Background}"
                  ClipToBounds="True">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Width" Duration="{motion:SpringDuration DefaultSpatial}" Easing="{motion:Spring DefaultSpatial}" />
              </Transitions>
            </Border.Transitions>
            <DockPanel Margin="0,12,0,12">
              <StackPanel Name="PART_Header" DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,40">
                <Button Name="PART_MenuButton"
                        Classes="Icon"
                        Margin="28,0"
                        HorizontalAlignment="Left"
                        IsVisible="{TemplateBinding ShowMenuButton}">
                  <Panel>
                    <PathIcon Name="PART_MenuIcon" Data="{StaticResource M3MenuGeometry}" />
                    <PathIcon Name="PART_MenuOpenIcon" Data="{StaticResource M3MenuOpenGeometry}" IsVisible="False" />
                  </Panel>
                </Button>
                <ContentPresenter Name="PART_HeaderPresenter"
                                  Margin="20,0"
                                  HorizontalAlignment="Left"
                                  Content="{TemplateBinding Header}" />
              </StackPanel>
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </ScrollViewer>
            </DockPanel>
          </Border>
          <!-- Clips only for a sliding page transition; otherwise it would cut off the shadows of the content. -->
          <Panel ClipToBounds="{TemplateBinding PageTransition, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentPresenter Name="PART_SelectedContentHost2"
                              Margin="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              IsVisible="False" />
            <ContentPresenter Name="PART_SelectedContentHost"
                              Margin="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Panel>
        </DockPanel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter:empty">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:expanded">
      <Style Selector="^ /template/ PathIcon#PART_MenuIcon">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^ /template/ PathIcon#PART_MenuOpenIcon">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
