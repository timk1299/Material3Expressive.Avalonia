<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>Material3Expressive.Avalonia</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>Material3Expressive.Avalonia</PackageId>
    <Version>0.3.1</Version>
    <Description>Material 3 Expressive theme for Avalonia UI: spring motion, shape morphing, the Material shape library, expressive components (button groups, split buttons, FAB menu, loading indicator, toolbars) and dynamic color (HCT).</Description>
    <PackageTags>avalonia;material;material3;material-you;material-expressive;theme;design</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Tim Kleinehelleforth</Authors>
    <Copyright>Copyright (c) 2026 Tim Kleinehelleforth</Copyright>
    <RepositoryUrl>https://github.com/timk1299/Material3Expressive.Avalonia</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/timk1299/Material3Expressive.Avalonia</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/timk1299/Material3Expressive.Avalonia/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
  </ItemGroup>

</Project>
